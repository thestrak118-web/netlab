#!/usr/bin/make -f

export PYBUILD_NAME = netlab
export DH_VERBOSE = 1

# The test suite must not try to open a display or a real capture device
# while building in a chroot.
export QT_QPA_PLATFORM = offscreen
export QT_QPA_PLATFORMTHEME = generic
export NETLAB_LIVE_TESTS = 0

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	PYTHONPATH=$(CURDIR)/src:$(CURDIR) python3 -m pytest $(CURDIR)/tests -q

override_dh_install:
	dh_install
	install -D -m 644 assets/netlab.svg \
	    debian/netlab/usr/share/icons/hicolor/scalable/apps/netlab.svg
	set -e; for size in 32 48 64 128 256; do \
	    install -D -m 644 assets/netlab-$$size.png \
	        debian/netlab/usr/share/icons/hicolor/$${size}x$${size}/apps/netlab.png; \
	done
	install -D -m 644 assets/netlab-128.png \
	    debian/netlab/usr/share/pixmaps/netlab.png
