<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>NetLab</vendor>

  <action id="uz.netlab.run">
    <description>Run NetLab with administrator rights</description>
    <description xml:lang="uz">NetLab'ni administrator huquqlari bilan ishga tushirish</description>
    <message>NetLab needs administrator rights to capture packets, discover devices and run an interception engagement.</message>
    <message xml:lang="uz">NetLab'ga paketlarni ushlash, qurilmalarni topish va ushlab qolish seansini o'tkazish uchun administrator huquqlari kerak.</message>
    <icon_name>netlab</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/netlab/netlab-as-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
